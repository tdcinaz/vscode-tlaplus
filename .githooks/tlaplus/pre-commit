#!/usr/bin/env bash
# Pre-commit guard for the tlaplus fork (submodule). Installed by `npm run tlatex:setup`.
# Bypass a single commit with `git commit --no-verify`.
set -euo pipefail

fail=0
staged="$(git diff --cached --name-only --diff-filter=ACMR)"

# 1. Eclipse metadata is regenerated by the Java language server; never commit it.
if grep -Eq '(^|/)(\.project|\.classpath)$|(^|/)\.settings/' <<<"${staged}"; then
    cat >&2 <<'MSG'
pre-commit: Eclipse metadata (.project/.classpath/.settings) is staged.
            These are generated. Fix:  git checkout -- <file> && git reset -- <file>
MSG
    fail=1
fi

# 2. Commit on the working branch, not a detached HEAD.
if ! git symbolic-ref -q HEAD >/dev/null; then
    cat >&2 <<'MSG'
pre-commit: HEAD is detached (typical after 'git submodule update').
            Run 'npm run tlatex:setup' from the extension repo, or
            'git switch tlatex-overhaul', then commit again.
MSG
    fail=1
fi

exit "${fail}"
