// A launch configuration that launches the extension inside a new window
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "npm: compile"
        },
        {
            "name": "Run Extension Tests",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--disable-extensions",
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--extensionTestsPath=${workspaceFolder}/out/tests/suite/index"
            ],
            "outFiles": ["${workspaceFolder}/out/tests/**/*.js"],
            "preLaunchTask": "npm: pretest"
        },
        {
            // Step through the typesetter itself. Requires the Java extension pack
            // (recommended) and a built tlatools project (npm run tlatex:build).
            "name": "Debug tla2tex.TLA on current .tla file",
            "type": "java",
            "request": "launch",
            "mainClass": "tla2tex.TLA",
            "projectName": "tlatools",
            "cwd": "${fileDirname}",
            "args": ["-latexCommand", "pdflatex", "-nops", "-shade", "-grayLevel", "0.85", "${fileBasename}"]
        },
        {
            "name": "Run TLA Plus Grammar Tests",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "args": [
                "run",
                "test:tlaplus-grammar"
            ]
        }
    ]
}
