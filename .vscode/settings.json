{
    "debug.node.autoAttach": "on",
    // Hide what TLATeX work never touches directly. Hidden entries are also
    // skipped by Quick Open and search; toggle by deleting the entry.
    "files.exclude": {
        // Repo plumbing, tool config, and generated output
        "**/.git": true,
        ".githooks": true,
        ".devcontainer": true,
        ".claude": true,
        ".vscode-test": true,
        "node_modules": true,
        "out": true,
        ".eslintignore": true,
        ".eslintrc.json": true,
        ".gitmodules": true,
        ".sonarcloud.properties": true,
        ".vscodeignore": true,
        "esbuild.js": true,
        "package-lock.json": true,
        "playwright.config.ts": true,
        "tsconfig*.json": true,
        "AGENTS.md": true,
        "CHANGELOG.md": true,
        "CONTRIBUTING.md": true,
        "LICENSE": true,
        // Extension assets and tests unrelated to TLATeX
        "languages": true,
        "resources": true,
        "tests/playwright": true,
        "tests/suite": true,
        "tests/runTest.ts": true,
        // tlaplus submodule: everything except tlatools/org.lamport.tlatools
        "tlaplus/.devcontainer": true,
        "tlaplus/.github": true,
        "tlaplus/.gitignore": true,
        "tlaplus/CNAME": true,
        "tlaplus/CONTRIBUTING.md": true,
        "tlaplus/DEVELOPING.md": true,
        "tlaplus/LICENSE": true,
        "tlaplus/README.md": true,
        "tlaplus/USE.md": true,
        "tlaplus/docs": true,
        "tlaplus/general": true,
        "tlaplus/keystore": true,
        "tlaplus/pom.xml": true,
        "tlaplus/toolbox": true,
        "tlaplus/tlatools/org.lamport.tlatools.*": true,
        // Eclipse metadata and build output inside org.lamport.tlatools
        "**/org.lamport.tlatools/.apt_generated": true,
        "**/org.lamport.tlatools/.classpath": true,
        "**/org.lamport.tlatools/.factorypath": true,
        "**/org.lamport.tlatools/.project": true,
        "**/org.lamport.tlatools/.settings": true,
        "**/org.lamport.tlatools/META-INF": true,
        "**/org.lamport.tlatools/TLA+ Tools": true,
        "**/org.lamport.tlatools/class": true,
        "**/org.lamport.tlatools/dist": true,
        "**/org.lamport.tlatools/lib": true,
        "**/org.lamport.tlatools/target": true,
        "**/org.lamport.tlatools/test-class": true,
        // Upstream sources and tests outside tla2tex
        "**/org.lamport.tlatools/{build.properties,build.xml.README,logging.properties,ossrh.xml,ossrh.xml.README,project.properties,pom.xml}": true,
        "**/org.lamport.tlatools/{doc,ide,javacc,jfr,spec}": true,
        "**/org.lamport.tlatools/{test-benchmark,test-concurrent,test-long,test-resources,test-verify,test-verify-model}": true,
        "**/org.lamport.tlatools/src/{formatter,model,org,pcal,tla2sany,tlc2,util}": true,
        "**/org.lamport.tlatools/test/{formatter,pcal,tla2sany,tlc2,util}": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "out/": true
	},
    // Java (tlaplus submodule): keep the Java language server from rewriting
    // the Eclipse .project/.settings files that upstream tlaplus commits.
    // org.lamport.tlatools ships a complete .classpath, so import it as a plain
    // Eclipse project instead of via Maven (m2e), and skip the other projects.
    "java.import.maven.enabled": false,
    // That .classpath sends compiler output to class/, the same directory the
    // Ant build uses. With auto-build on, the language server compiles the
    // test sources into class/ too (without JUnit, which is not on the Eclipse
    // classpath), and those broken copies shadow Ant's test-class output.
    // Build with `npm run tlatex:build`; run "Java: Force Java Compilation"
    // only when you need the IDE's own compile.
    "java.autobuild.enabled": false,
    "java.project.resourceFilters": [],
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**",
        "**/tlaplus/general/**",
        "**/tlaplus/toolbox/**",
        "**/tlaplus/tlatools/org.lamport.tlatools.*/**"
    ],
    "tlaplus.tlc.modelChecker.options": "-workers 1 -coverage 1"
}
