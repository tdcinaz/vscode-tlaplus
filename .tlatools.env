# TLATeX (tla2tex) source coordinates — shared by the whole team.
#
# scripts/tlatex-dev.sh reads this file to know which fork/branch of the
# tlaplus/tlaplus repo to build tla2tools.jar from. Commit changes here so
# every teammate builds the exact same source. Per-shell overrides are still
# possible via the TLATOOLS_REPO / TLATOOLS_REF environment variables.
#
# Point these at your team's fork + working branch for the overhaul:
TLATOOLS_REPO=https://github.com/tlaplus/tlaplus.git
TLATOOLS_REF=master

# Local checkout directory (gitignored). Rarely needs changing.
TLATOOLS_DIR=.tlatools
